@model List<ecommercesite.Models.ProductCategory>

@{
    ViewData["Title"] = "Product Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Product Categories</h2>
        <p class="text-muted small mb-0">Organize your catalog by category.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Category</a>
</div>

@using (Html.BeginForm("Index", "ProductCat", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-5">
        @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control", placeholder = "Search category...", autocomplete = "off" })
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
    <div class="col-md-auto">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Category Name</th>
                <th>Description</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No categories found.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryId</td>
                    <td>@item.CategoryName</td>
                    <td class="text-muted">@(item.Description ?? "—")</td>
                    <td class="small text-muted">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-info">View</a>
                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Category pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">&laquo; Previous</a>
            </li>
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">Next &raquo;</a>
            </li>
        </ul>
    </nav>
}
