@model ecommercesite.Models.ProductCategory

@{
    ViewData["Title"] = "Delete Category";

    var productCount = Model.Products?.Count ?? 0;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0 h5">Confirm Delete</h3>
            </div>
            <div class="card-body">
                <p class="mb-2">Are you sure you want to delete this category?</p>
                <p class="mb-1">
                    <strong>@Model.CategoryName</strong>
                </p>
                <p class="mb-1 text-muted small">
                    ID: <code>@Model.CategoryId</code>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <text> &middot; @Model.Description</text>
                    }
                </p>

                @if (productCount > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <strong>Warning:</strong> This category currently contains
                        <strong>@productCount</strong> product@(productCount == 1 ? "" : "s").
                        Deleting it will fail because products reference it. Reassign or
                        delete those products first.
                    </div>
                }
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.CategoryId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>