@model ecommercesite.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0 h5 text-center">Login</h3>
            </div>
            <div class="card-body">
                <form asp-action="Index" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <!-- Echo the page the user originally requested (set by
                         [RequireLogin] via ?returnUrl=...) so the POST action
                         can send them straight back after a successful login. -->
                    <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl as string)" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>

                @{
                    var providers = ViewBag.ExternalProviders
                        as List<ecommercesite.Controllers.AccountController.ExternalProvider>
                        ?? new List<ecommercesite.Controllers.AccountController.ExternalProvider>();
                }
                @if (providers.Count > 0)
                {
                    <div class="text-center text-muted small my-3">&mdash; or sign in with &mdash;</div>
                    @foreach (var p in providers)
                    {
                        // Known first-class providers get a branded SVG logo.
                        // Generic OAuth2 providers get a colored circle with
                        // the first letter of their display name.
                        var logo = p.Scheme switch
                        {
                            "Google" => @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" xmlns=""http://www.w3.org/2000/svg""><path fill=""#4285F4"" d=""M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z""/><path fill=""#34A853"" d=""M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z""/><path fill=""#FBBC05"" d=""M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z""/><path fill=""#EA4335"" d=""M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z""/></svg>",
                            "Microsoft" => @"<svg width=""18"" height=""18"" viewBox=""0 0 23 23"" xmlns=""http://www.w3.org/2000/svg""><path fill=""#F25022"" d=""M1 1h10v10H1z""/><path fill=""#00A4EF"" d=""M1 12h10v10H1z""/><path fill=""#7FBA00"" d=""M12 1h10v10H12z""/><path fill=""#FFB900"" d=""M12 12h10v10H12z""/></svg>",
                            "Facebook" => @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" xmlns=""http://www.w3.org/2000/svg""><path fill=""#1877F2"" d=""M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z""/></svg>",
                            "Twitter" => @"<svg width=""18"" height=""18"" viewBox=""0 0 24 24"" xmlns=""http://www.w3.org/2000/svg""><path fill=""#1DA1F2"" d=""M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z""/></svg>",
                            _ => $@"<span class=""d-inline-flex align-items-center justify-content-center rounded-circle text-white fw-bold"" style=""width:18px;height:18px;font-size:11px;background-color:{p.Color ?? "#6c757d"}"">{(string.IsNullOrEmpty(p.DisplayName) ? "?" : p.DisplayName[..1].ToUpperInvariant())}</span>"
                        };
                        <a asp-action="ExternalLogin" asp-controller="Account"
                           asp-route-provider="@p.Scheme"
                           asp-route-returnUrl="@(ViewBag.ReturnUrl as string)"
                           class="btn btn-outline-secondary w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                            @Html.Raw(logo)
                            <span>Login with @p.DisplayName</span>
                        </a>
                    }
                }
            </div>
            <div class="card-footer text-center">
                <span class="text-muted small">Don't have an account?</span>
                <a asp-controller="RegisterController1" asp-action="Create" class="small">Register</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
