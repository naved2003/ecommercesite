@model ecommercesite.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0 h5">Confirm Delete</h3>
            </div>
            <div class="card-body">
                <p class="mb-2">Are you sure you want to delete this product?</p>
                <p class="mb-0">
                    <strong>@Model.ProductName</strong>
                    <br />
                    <span class="text-muted small">
                        ID: <code>@Model.ProductId</code> &middot;
                        Price: @Model.Price.ToString("C")
                    </span>
                </p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.ProductId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
