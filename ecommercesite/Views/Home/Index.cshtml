@model IEnumerable<ecommercesite.Models.Register>

@{
    ViewData["Title"] = "Customer Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Customer Accounts</h2>
        <p class="text-muted small mb-0">Registered customer accounts. Admins can create, edit, and remove accounts.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Account</a>
</div>

@using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "row g-2 mb-3 align-items-end" }))
{
    <div class="col-md-5">
        <label class="form-label small text-muted mb-1">Search</label>
        @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control", placeholder = "Name, email, phone...", autocomplete = "off" })
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
    <div class="col-md-auto">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Registered</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No customer accounts found. Customers register themselves via the Register page.
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.FullName</strong></td>
                            <td><a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a></td>
                            <td>@c.PhoneNumber</td>
                            <td class="small text-muted">@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@c.UserId" class="btn btn-sm btn-outline-info">View</a>
                                <a asp-action="Edit" asp-route-id="@c.UserId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@c.UserId" class="btn btn-sm btn-outline-danger">Remove</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>