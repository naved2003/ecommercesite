@model IEnumerable<ecommercesite.Models.DeliveryPerson>

@{
    ViewData["Title"] = "Delivery Personnel";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Delivery Personnel</h2>
        <p class="text-muted small mb-0">Manage the team that fulfills order shipments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Delivery Person</a>
</div>

@using (Html.BeginForm("Index", "DeliveryPerson", FormMethod.Get, new { @class = "row g-2 mb-3 align-items-end" }))
{
    <div class="col-md-6">
        <label class="form-label small text-muted mb-1">Search</label>
        @Html.TextBox("search", ViewBag.Search as string, new { @class = "form-control", placeholder = "Name, phone, vehicle, area...", autocomplete = "off" })
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
    <div class="col-md-auto">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Vehicle</th>
                        <th>Area</th>
                        <th>Status</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No delivery personnel found.</td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        var badgeClass = p.Status switch
                        {
                            "Available" => "bg-success",
                            "Busy" => "bg-warning text-dark",
                            "Offline" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };
                        <tr>
                            <td><code>#@p.Id</code></td>
                            <td>@p.Name</td>
                            <td>@p.Phone</td>
                            <td>@(p.VehicleNumber ?? "—")</td>
                            <td>@(p.AssignedArea ?? "—")</td>
                            <td><span class="badge @badgeClass">@p.Status</span></td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">View</a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <nav aria-label="Delivery pagination">
                <ul class="pagination justify-content-center mb-0">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">&laquo; Previous</a>
                        </li>
                    }
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                            <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a></li>
                        }
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">Next &raquo;</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>