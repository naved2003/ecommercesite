@model ecommercesite.Models.DeliveryPerson

@{
    ViewData["Title"] = "Delete Delivery Person";

    var assignedCount = Model.AssignedOrders?.Count ?? 0;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0 h5">Confirm Delete</h3>
            </div>
            <div class="card-body">
                <p class="mb-2">Are you sure you want to delete this delivery person?</p>
                <p class="mb-1">
                    <strong>@Model.Name</strong>
                </p>
                <p class="mb-1 text-muted small">
                    ID: <code>#@Model.Id</code> &middot;
                    Phone: @Model.Phone &middot;
                    Status: @Model.Status
                </p>

                @if (assignedCount > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <strong>Note:</strong> This delivery person currently has
                        <strong>@assignedCount</strong> assigned order@(assignedCount == 1 ? "" : "s").
                        Deleting them will set <code>DeliveryPersonId</code> to NULL on those orders
                        (the FK uses <em>SET NULL</em>), so the orders will need to be reassigned.
                    </div>
                }
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>